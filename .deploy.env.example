# ─────────────────────────────────────────────────────────────────
# Copia este archivo como .deploy.env y completa los valores reales.
# NUNCA commitees .deploy.env — está en .gitignore.
# En GitHub Actions estas variables se inyectan como Secrets.
# ─────────────────────────────────────────────────────────────────

# Rutas locales a los proyectos (solo para ejecución local)
BACKEND_PROJECT_PATH=../mi-proyecto-backend
FRONTEND_PROJECT_PATH=../mi-proyecto-frontend

# ── FTP ──────────────────────────────────────────────────────────
FTP_HOST=ftp.tudominio.com
FTP_USER=usuario_ftp
FTP_PASSWORD=password_ftp

# Directorios remotos destino en el servidor cPanel
FTP_BACKEND_REMOTE_DIR=/public_html/api/
FTP_FRONTEND_REMOTE_DIR=/public_html/

# ── Backend Laravel ───────────────────────────────────────────────
# Opción A: ruta a un archivo .env de producción local
BACKEND_ENV_PRODUCTION=./envs/.env.backend.production

# Opción B: contenido completo del .env como string (usado en GitHub Actions)
# BACKEND_ENV_PRODUCTION=APP_NAME=MiApp\nAPP_ENV=production\n...

# ── Webhook post-deploy (backend) ────────────────────────────────
DEPLOY_BACKEND_WEBHOOK_URL=https://tudominio.com/deploy.php
DEPLOY_BACKEND_SECRET=token_secreto_muy_largo_y_aleatorio
